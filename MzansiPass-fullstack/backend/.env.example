# Copy to .env and replace each CHANGE_ME_* value with independent
# cryptographically random secrets BEFORE starting the backend.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_48_BYTES
JWT_SECRET_KEY=CHANGE_ME_GENERATE_ANOTHER_RANDOM_48_BYTES
DATABASE_URL=postgresql://postgres:postgres@db:5432/mzansi

# On a local HTTPS Vite frontend this cookie must use Secure=true.
PULSE_COOKIE_SECURE=true
PULSE_ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173

# Only on a disposable, empty technical-pilot database.
# Set to 0 once schema migrations have been applied.
PULSE_BOOTSTRAP_DB=1

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE=https://api.paystack.co
ADMIN_EMAIL=
ADMIN_PASSWORD=

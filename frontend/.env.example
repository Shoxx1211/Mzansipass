# .env.example
# Copy this file to .env and fill in your values

# ======================================================
# REQUIRED - API Keys
# ======================================================
# Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ======================================================
# App Configuration
# ======================================================
VITE_APP_NAME=Pulse Transit
VITE_APP_VERSION=3.0.0
VITE_APP_ENV=development

# ======================================================
# API Endpoints
# ======================================================
VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/api
VITE_API_TIMEOUT=10000

# ======================================================
# Third-Party APIs (Optional)
# ======================================================
# Public Mapbox token for South African addresses, areas and landmarks.
# If URL-restricted, allow localhost and the assigned public deployment URL.
VITE_MAPBOX_TOKEN=
# Google Maps (for location autocomplete)
VITE_MAPS_API_KEY=

# Payment Gateways
VITE_PAYSTACK_PUBLIC_KEY=
VITE_STRIPE_PUBLIC_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# ======================================================
# Feature Flags
# ======================================================
VITE_ENABLE_GEMINI=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_BACKGROUND_TRACKING=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_ANALYTICS=false
# Production must reverse-proxy /api/auth/* to the Flask passenger backend.
# Browser auth must be SAME ORIGIN for the HttpOnly refresh cookie.
# No JWT or backend secret belongs in a VITE_* variable.

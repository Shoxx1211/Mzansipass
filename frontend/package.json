{
  "name": "pulse-transit",
  "private": true,
  "version": "3.0.0",
  "description": "Pulse Transit - Smart commuting for South Africa. Track trips, estimate fares, and navigate public transport with AI assistance.",
  "type": "module",
  "author": "Pulse Transit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/pulse-transit.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/pulse-transit/issues"
  },
  "homepage": "https://pulse-transit.app",
  "keywords": [
    "transit",
    "south-africa",
    "commuting",
    "taxi",
    "gautrain",
    "fare-calculator",
    "trip-tracker",
    "pwa",
    "capacitor",
    "react",
    "typescript",
    "ai-assistant"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:android": "npm run build && npx cap copy android && npx cap sync android",
    "build:ios": "npm run build && npx cap copy ios && npx cap sync ios",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "pwa:generate": "npx @vite-pwa/assets-generator --preset minimal public/logo.svg",
    "analyze": "vite build --mode analyze",
    "prepare": "husky install",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@google/genai": "^1.43.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.2.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.394.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "swr": "^2.2.5",
    "use-debounce": "^10.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.4.0",
    "@vitest/ui": "^1.4.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "happy-dom": "^14.3.10",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^1.4.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not android <= 4.4",
      "not ios <= 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
